# Copy this file to config/g1_runtime.env after extracting the package.
# The live launchers refuse to start until the copy exists.

# Listen on all G1 PC2 interfaces.  Restrict access with VIVE_SENDER_IP below.
BIND_ADDRESS=0.0.0.0

# Current two-process layout: Unity sends the same complete packet to both.
LEFT_UDP_PORT=5005
RIGHT_UDP_PORT=5006

# Optional but recommended after the headset address is known.  Leave empty
# for the first network checkout, then set it to the VIVE Wi-Fi address.
VIVE_SENDER_IP=

# Prefer persistent /dev/serial/by-id/... paths.  /dev/ttyUSB* numbering can
# swap after reboot or when adapters are replugged.
LEFT_SERIAL_PORT=/dev/ttyUSB0
RIGHT_SERIAL_PORT=/dev/ttyUSB1

# Each hand is on an independent RS485 adapter, so both can normally use ID 1.
LEFT_HAND_ID=1
RIGHT_HAND_ID=1

# Conservative first-checkout values.  After every joint direction and limit
# is verified on the assembled robot, MAX_STEP_UNITS can be raised gradually
# toward the previously used value 20 (each unit is 0.1 degree).
HARDWARE_RATE_HZ=10
MAX_STEP_UNITS=2
HEALTH_CHECK_PERIOD_S=2
STATUS_INTERVAL_S=0.5

# Optional Linux CPU lists, for example LEFT_CPUSET=2 and RIGHT_CPUSET=3.
# Leave empty until solve timing on the Orin NX has been measured.
LEFT_CPUSET=
RIGHT_CPUSET=

# Keep numerical libraries from creating many nested worker threads.  The
# final architecture already uses one independent process per hand.
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
